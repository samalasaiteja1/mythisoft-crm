{
  "name": "mythisoft-crm-server",
  "version": "1.0.0",
  "description": "MYTHISOFT CRM Backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'No server build step required'",
    "build:client": "npm --prefix ../client install && npm --prefix ../client run build",
    "postinstall": "npm run build:client || true",
    "deploy": "npm run build:client && npm start",
    "seed": "node utils/seed.js",
    "seed:code-review": "node utils/seedCodeReviewSamples.js",
    "seed:examples": "node utils/seedExamples.js",
    "reset-demo-passwords": "node utils/resetDemoPasswords.js"
  },
  "engines": {
    "node": "18.x"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
